# 이 파일에 실제 값을 넣지 않는다. 값은 로컬 .env 와 Vercel 환경변수에만 둔다.
# 이름과 용도만 적는다. NEXT_PUBLIC_ 접두사는 클라이언트 번들에 그대로 박히므로
# 비밀값에는 절대 붙이지 않는다.
#
# 배포 쪽 설정 절차는 docs/SETUP.md 에 있다.

# ── 웹앱 런타임 필수 ───────────────────────────────────────────────────────

# Neon Postgres 연결 문자열. 서버 사이드 전용.
# 웹앱이 실행 중에 읽는다: /api/import 저장 경로와 /report 조회 경로가 둘 다
# lib/db/client.mjs 를 거친다. 스크립트 전용 변수가 아니다.
DATABASE_URL=

# 세션 JWT 서명·암호화 키. `openssl rand -base64 32` 등으로 생성한다.
# 바꾸면 이미 발급된 세션 쿠키가 전부 무효가 된다(재로그인 필요).
# (Auth.js v5 는 AUTH_SECRET 을 먼저 보고 없으면 NEXTAUTH_SECRET 을 읽는다.
#  새로 넣는다면 AUTH_SECRET 하나만 쓴다.)
AUTH_SECRET=

# Google OAuth 클라이언트 (Auth.js v5 규약 이름).
# GOOGLE_CLIENT_ID 같은 다른 이름은 코드가 읽지 않는다.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# 로그인을 허용할 이메일.
#   - 구분자는 쉼표(,) 하나뿐이다. 공백·줄바꿈·세미콜론은 구분자가 아니다.
#   - 항목의 앞뒤 공백은 잘라 낸다. 대소문자는 구분하지 않는다.
#   - 비어 있거나 설정하지 않으면 아무도 로그인할 수 없다(fail closed).
# 예: ALLOWED_EMAILS=first@example.com,second@example.com
ALLOWED_EMAILS=

# ── 선택 ───────────────────────────────────────────────────────────────────
#
# 아래 둘은 Vercel 배포에서는 보통 넣지 않는다.
#
# AUTH_URL / NEXTAUTH_URL — 요청 헤더 대신 이 URL 을 앱 주소로 못 박는다.
#   넣지 않으면 x-forwarded-host 헤더로 잡는다. 프로덕션 도메인으로 고정하면
#   프리뷰 배포의 로그인이 어긋날 수 있다.
# AUTH_URL=
#
# AUTH_TRUST_HOST — 프록시가 보낸 호스트 헤더를 믿을지 여부. Vercel 에서는
#   시스템 환경변수 VERCEL 만으로 이미 켜진다. 그 주입을 꺼 둔 경우에만 필요.
# AUTH_TRUST_HOST=

# ── 웹앱이 읽지 않는 것 (스크립트 · 테스트 전용) ──────────────────────────
#
# ACCOUNT_LAST4_MAIN / ACCOUNT_LAST4_FIXED / ACCOUNT_LAST4_EMERGENCY
#   `npm run accounts:seed` 전용(scripts/seed-accounts.mjs). 계좌번호 뒤 4자리다.
#   CLI 인자 대신 환경변수로 넘긴다 — npm 이 명령줄을 로그에 그대로 출력한다.
#   여기에는 이름만 적는다. 값은 이 파일에도, 커밋에도 남기지 않는다.
#
# TEST_DATABASE_URL
#   DB 왕복 테스트 전용. 없으면 해당 테스트는 skip 된다. 로컬 호스트가 아니면
#   테스트가 거부한다 — 운영 Neon 을 가리키는 값을 넣지 않는다.
# TEST_DATABASE_URL=
