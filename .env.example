# 이 파일에 실제 값을 넣지 않는다. 값은 로컬 .env 와 Vercel 환경변수에만 둔다.
# 이름과 용도만 적는다. NEXT_PUBLIC_ 접두사는 클라이언트 번들에 그대로 박히므로
# 비밀값에는 절대 붙이지 않는다.

# Neon Postgres 연결 문자열. 서버 사이드 전용.
DATABASE_URL=

# 배포 URL. OAuth 콜백 주소 계산에 쓴다. (Auth.js v5 는 AUTH_URL 도 같은 뜻으로 읽는다)
NEXTAUTH_URL=

# 세션 JWT 암호화 키. `openssl rand -base64 32` 등으로 생성한다.
# (Auth.js v5 는 AUTH_SECRET 을 먼저 보고 없으면 이 이름을 읽는다)
NEXTAUTH_SECRET=

# Google OAuth 클라이언트 (Auth.js v5 규약 이름).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# 로그인을 허용할 이메일. 쉼표로 구분한다. 비어 있으면 아무도 로그인할 수 없다.
ALLOWED_EMAILS=
